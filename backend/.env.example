# SQLite by default — works instantly, no external DB needed.
# Swap to a Postgres URL + change provider in prisma/schema.prisma to use Postgres.
DATABASE_URL="file:./dev.db"

# Any long random string. Used to sign JWTs.
AUTH_SECRET="replace-with-a-long-random-string"

PORT=4000

# Optional — only needed if BugAnalysisService is wired to a real LLM later.
# Never exposed to the frontend; read server-side only.
AI_API_KEY=""

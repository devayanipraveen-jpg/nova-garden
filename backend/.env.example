# prisma/schema.prisma is set to provider = "postgresql", so this MUST be a
# real postgresql:// connection string (e.g. from Neon, Supabase, or Vercel
# Postgres) - a "file:./dev.db" style SQLite path will fail on Vercel.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Any long random string. Used to sign JWTs.
AUTH_SECRET="replace-with-a-long-random-string"

PORT=4000

# Optional — only needed if BugAnalysisService is wired to a real LLM later.
# Never exposed to the frontend; read server-side only.
AI_API_KEY=""
